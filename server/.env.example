TONICUISC_HOST=0.0.0.0
TONICUISC_PORT=8000
TONICUISC_SOURCES=migu,kuwo
# 每个音源要多少首
TONICUISC_SEARCH_SIZE=10
# 每个请求取几条：1 = 10 首拆成 10 个请求并行拿（默认）
TONICUISC_SEARCH_SIZE_PER_PAGE=1
# 每个音源的并发请求数
TONICUISC_SEARCH_THREADS=10
# TONICUISC_CACHE_DIR=D:\AphidTonic\Tonicuisc\server\.cache
# SQLite 库位置（默认 <CACHE_DIR>\tonicuisc.db）
# TONICUISC_DB=D:\AphidTonic\Tonicuisc\server\.cache\tonicuisc.db
