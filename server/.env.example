# 监听地址。家里部署（外网 IPv6 → Caddy → 本机）时设 127.0.0.1：
# 服务端只收本机 IPv4 回环，外面只能从 Caddy 的 443 进来，接口不直接对外。
TONICUISC_HOST=127.0.0.1
TONICUISC_PORT=8000
# 网页（落地页 + 网页播放器 + 网页会话）由 Python 自己托管：`/`、`/music`、
# `/music/api/session` 和 `/api` 在同一个进程里，`python -m tonicuisc_server`
# 一条命令就全跑起来，不需要 Node。想回到「Caddy → Node(webapp/server.js) → Python」
# 的老拓扑，把它设成 0，并配上下面的 TONICUISC_WEB_PORT。
TONICUISC_WEB_BUILTIN=1
# Node 网页入口端口。**只在 TONICUISC_WEB_BUILTIN=0 时有意义**（Caddy 反代到这里）；
# 不填就退回 TONICUISC_PORT。
# TONICUISC_WEB_PORT=8080
# 静态文件目录（落地页 / 播放器的 HTML/CSS/JS）。默认仓库里的 webapp/public，
# 单独打包部署时可以指过去。
# TONICUISC_WEB_PUBLIC=D:\AphidTonic\Tonicuisc\webapp\public
# 网页会话（HttpOnly Cookie）有效期（秒），默认 7 天。进程重启会清空内存会话，
# 浏览器需要重新配对一次（API Key 不落盘）。
# TONICUISC_WEB_SESSION_TTL=604800
# 「记住这台浏览器」：浏览器带一枚长期指纹 Cookie（tuisc_web_id，相当于网页播放器的
# MAC 地址），服务端把它绑到一台设备记录上。好处有两个：
#   1. 服务端重启后内存会话没了，前端第一次轮询就按指纹自动恢复登录，不用重新配对；
#   2. 同一个浏览器反复登录只占设备列表里的一条「网页播放器」。
# 恢复时是按设备记录重新签发 key（旧 key 作废），Redis 里存的只是「指纹 → 设备」的指针。
# 设备被吊销 / 从设备列表删掉，绑定立刻失效。设 0 关掉这套机制（每次都重新配对）。
# TONICUISC_WEB_REMEMBER=1
# 上面那条绑定的有效期（秒），默认 30 天；每次成功恢复登录都会续期。
# TONICUISC_WEB_REMEMBER_TTL=2592000
# 只保留酷我。想临时加回咪咕就把 migu 写进来（代码里还留着兼容）
TONICUISC_SOURCES=kuwo
# 桌面端检查更新：GitHub 仓库和可选 token（不填 token 时匿名 60 次/小时）
TONICUISC_GITHUB_REPO=TonicAphid/Tonicuisc
TONICUISC_GITHUB_TOKEN=
# 每个音源的抓取下限（真正抓多少按「这次要几条 ÷ 音源数」分摊，不多拉）
TONICUISC_SEARCH_SIZE=5
# 每个请求至少取几首（下限）；实际每页条数 = max(这个值, ceil(要几条 ÷ 并发数))
TONICUISC_SEARCH_SIZE_PER_PAGE=1
# 每个音源的并发请求数；musicdl 一个请求内部是串行解析的，所以这个数就是并行度
TONICUISC_SEARCH_THREADS=5
# 设备 API Key 校验（0 = 关闭，任何人都能调接口）
TONICUISC_AUTH=1
# 设备码（登录请求）有效期（秒）
TONICUISC_DEVICE_CODE_TTL=600
# 对外地址：启动横幅里打印登录链接用，也是 App 里填的地址
TONICUISC_PUBLIC_URL=https://uisc.tonicaphid.cn
# 限速按真实来源 IP 算：默认信任反向代理写的 X-Forwarded-For。
# 如果直接把端口暴露到公网（没有反代），设成 0，否则可以伪造这个头绕过限速。
TONICUISC_TRUST_PROXY=1
# ---------------------------- HTTPS ----------------------------
# 两条路选一条：
#   A. 反代终止（默认就是这条）：上面 PUBLIC_URL 填 https://域名，
#      Caddy 监听公网 443、反代到 127.0.0.1:8000 的 Python（接口 + 网页同一个进程，
#      见 deploy/Caddyfile）。
#      服务端因此设 TONICUISC_HOST=127.0.0.1，只跑明文 HTTP 在本机回环上。
#      证书由 lego 走 **DNS-01**（阿里云解析）向 Let's Encrypt 申请——**不需要入站 80/443**，
#      所以运营商封了端口、路由器没做映射也能签下来：
#          python -m tonicuisc_server acme --issue     # 签（复用 deploy/.aliyun.env 的 AK）
#          python -m tonicuisc_server caddy --start    # 起 Caddy（会自动用上那张证书）
#      服务端启动时会自动做这两步（见下面的 CADDY_AUTOSTART / ACME_DNS01）。
#   B. 原生 TLS（内网 / 不想装 Caddy）：两个都填才生效，只填一个当没配
#      证书用 python -m tonicuisc_server cert <域名或IP> 生成（自签，手机要手动信任）
# TONICUISC_TLS_CERT=D:\AphidTonic\Tonicuisc\server\.cache\tls\192.168.5.37.crt
# TONICUISC_TLS_KEY=D:\AphidTonic\Tonicuisc\server\.cache\tls\192.168.5.37.key
# 启动服务时顺手把 Caddy 也拉起来（默认 1；只想局域网直连不挂 HTTPS 就设 0）
TONICUISC_CADDY_AUTOSTART=1
# Caddy 的运行时日志往哪写：file（默认，写 deploy/.caddy/runtime.log，控制台清爽）
# 或 console（实时刷屏，排查时用）
# TONICUISC_CADDY_LOG=file
# 用 lego + DNS-01 签证书（默认 1）。设 0 则退回 Caddy 自带的 HTTP-01/TLS-ALPN-01，
# 那种方式**需要外网能连到 80/443**，家里宽带常被封。
TONICUISC_ACME_DNS01=1
# 证书联系邮箱（Let's Encrypt 用它发到期提醒，可留空）
# TONICUISC_ACME_EMAIL=you@example.com
# 调试时可填 staging，避免撞生产环境的签发限额（浏览器会不信任 staging 证书）
# TONICUISC_ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
# asyncio 的线程池大小：搜索 / 边下边播的读 / 每次 Redis 调用都走它，默认 64
TONICUISC_THREADS=64
# 用 QQ 音乐补封面（咪咕/酷我的封面经常糊）；0 = 用音源原始封面
# 搜索不等封面：返回音源原图，同时后台把这批歌的 QQ 封面并发查好写进 Redis
TONICUISC_QQ_COVER=1
# 补封面时的并发数（QQ 单次要 3~4 秒，实测 8 路比 4 路快一倍）
TONICUISC_QQ_COVER_THREADS=8
# /api/covers 最多等正在跑的封面查询多久（秒）；等不到就先给音源原图
TONICUISC_QQ_COVER_WAIT=25
# QQ 封面查询的 LRU 记忆条数
TONICUISC_QQ_COVER_CACHE=2048
# 搜索结果在 Redis 里保留多久（秒）；重启后依然命中，不会重新联网搜
TONICUISC_SEARCH_TTL=86400
# 软刷新窗口（秒）：客户端带 refresh=true 时，缓存比这新就直接返回（几十毫秒），
# 同时在后台重新搜一遍更新缓存。App 每次搜索都带 refresh=true，靠它才不会每次重搜。
TONICUISC_SEARCH_SOFT_TTL=600
# ---------------- Redis（数据现在全放 Redis）----------------
# 完整地址。填了就用它，而且服务端只「连」不「管」（不会启动/关闭它）。
# TONICUISC_REDIS_URL=redis://127.0.0.1:6390/0
# 没填 URL 时用这组参数连本地 Redis，也是托管模式启动时的监听参数
TONICUISC_REDIS_HOST=127.0.0.1
TONICUISC_REDIS_PORT=6390
TONICUISC_REDIS_DB=0
# 指定 redis-server 可执行文件；不填就按 redis\<win|linux>\ → PATH → 自动下载 找
# TONICUISC_REDIS_SERVER=D:\AphidTonic\Tonicuisc\redis\win\redis-server.exe
# 托管 Redis 的目录：二进制放 <这里>\win 或 \linux，数据放 <CACHE_DIR>\redis
# TONICUISC_REDIS_DIR=D:\AphidTonic\Tonicuisc\redis
# 启动服务时自动拉起 Redis（0 = 只连已经跑着的）
TONICUISC_REDIS_AUTOSTART=1
# 首次启动找不到 redis-server 时自动下载（0 = 直接报错，让人手动装）
TONICUISC_REDIS_DOWNLOAD=1
# 托管实例开 AOF 持久化（数据都在 Redis 里，默认开，重启不丢）
TONICUISC_REDIS_APPENDONLY=1
# TONICUISC_CACHE_DIR=D:\AphidTonic\Tonicuisc\server\.cache
# 旧 SQLite 库位置：只给迁移脚本用（python scripts/import_sqlite.py）
# TONICUISC_DB=D:\AphidTonic\Tonicuisc\server\.cache\tonicuisc.db
