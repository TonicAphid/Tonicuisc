# 阿里云 AK（给 deploy/update_aaaa.py --update 用）。
#
# 用法：把下面两行的值填上，然后 `python deploy/update_aaaa.py --update`
#   - 建议用 RAM 子账号（只要 AliyunDNSFullAccess），别用主账号 AK
#   - 这个文件已经在 .gitignore 里，不会被提交
#   - 也可以改用环境变量 ALIYUN_ACCESS_KEY_ID / ALIYUN_ACCESS_KEY_SECRET（环境变量优先）
#
# 示例：
#   ALIYUN_ACCESS_KEY_ID=LTAI5tExampleExample
#   ALIYUN_ACCESS_KEY_SECRET=ExampleSecretExampleSecret

ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
